DATABASE_URL=postgres://bookish:PASSWORD@localhost:5432/bookish_corner
# Only in the cloud: path (inside server/) to the database's root certificate
DATABASE_CA=certs/supabase-ca.crt

SESSION_SECRET=PUT_A_LONG_RANDOM_STRING_HERE


SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=PUT_THE_SECRET_KEY_HERE
SIGNUP_OPEN=true

RESEND_API_KEY=re_PUT_YOUR_KEY_HERE
MAIL_FROM=A Library of Us <no-reply@alibraryofus.com>

GOOGLE_CLIENT_ID=PUT_THE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PUT_THE_CLIENT_SECRET_HERE

VAPID_PUBLIC_KEY=PUT_THE_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=PUT_THE_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:admin@alibraryofus.com

PADDLE_ENV=sandbox
PADDLE_API_KEY=PUT_THE_API_KEY_HERE
PADDLE_CLIENT_TOKEN=PUT_THE_CLIENT_TOKEN_HERE
PADDLE_PRICE_ID=pri_PUT_THE_PRICE_ID_HERE
PADDLE_WEBHOOK_SECRET=PUT_THE_WEBHOOK_SECRET_HERE
